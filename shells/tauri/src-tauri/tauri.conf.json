{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MindModel",
  "version": "0.1.0",
  "identifier": "com.maclab.mindmodel",
  "build": {
    "beforeDevCommand": "echo 前端由 ui/ 目录提供，见 DESIGN.md",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "echo 前端由 ui/ 目录提供，见 DESIGN.md",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MindModel",
        "width": 1040,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
